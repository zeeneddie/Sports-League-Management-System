[Unit]
Description=SPMS Flask Application
After=network.target

[Service]
Type=simple
User=spms
Group=spms
WorkingDirectory=/var/www/spms
ExecStart=/bin/bash -c 'cd /var/www/spms && source venv/bin/activate && exec gunicorn --bind 127.0.0.1:5000 --workers 1 --timeout 120 app:app'
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
